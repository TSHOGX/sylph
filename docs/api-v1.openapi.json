{
  "openapi": "3.1.0",
  "info": {
    "title": "Sylph Local Agent Runtime Service",
    "version": "0.1.0",
    "description": "Loopback-only, versioned API for durable sessions, turns, normalized events, and runner capabilities. Backend and agent-native session identifiers are never exposed in ordinary session responses."
  },
  "servers": [{ "url": "http://127.0.0.1:4317" }],
  "security": [{ "SylphSessionCookie": [] }],
  "paths": {
    "/api/v1/health": { "get": { "security": [], "responses": { "200": { "description": "Service health" } } } },
    "/api/v1/diagnostics": { "get": { "responses": { "200": { "description": "Diagnostics snapshot" } } } },
    "/api/v1/agents": { "get": { "responses": { "200": { "description": "Discovered runner capabilities" } } } },
    "/api/v1/agents/refresh": { "post": { "responses": { "200": { "description": "Refreshed capabilities" } } } },
    "/api/v1/sessions": {
      "get": { "responses": { "200": { "description": "Product sessions" } } },
      "post": { "requestBody": { "$ref": "#/components/requestBodies/CreateSession" }, "responses": { "201": { "$ref": "#/components/responses/SessionCreated" }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/sessions/import": { "post": { "requestBody": { "$ref": "#/components/requestBodies/ImportSession" }, "responses": { "201": { "$ref": "#/components/responses/SessionCreated" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/sessions/{sessionId}": { "get": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }], "responses": { "200": { "description": "Session detail" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/sessions/{sessionId}/turns": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Before" }], "responses": { "200": { "description": "Turn list" } } },
      "post": { "parameters": [{ "$ref": "#/components/parameters/SessionId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "$ref": "#/components/requestBodies/CreateTurn" }, "responses": { "202": { "$ref": "#/components/responses/TurnAccepted" }, "200": { "$ref": "#/components/responses/TurnAccepted" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/v1/search": { "get": { "parameters": [{ "$ref": "#/components/parameters/Query" }, { "$ref": "#/components/parameters/Limit" }], "description": "Search the durable TraceDB archive. Hits are lineage-collapsed and ranked by TraceDB, which owns both. A whitespace-only query returns no results without consulting the archive. An unreachable archive is a normal local state, so it answers 200 with available=false rather than 503.", "responses": { "200": { "description": "Archive search results", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResponse" } } } } } } },
    "/api/v1/turns/{turnId}": { "get": { "parameters": [{ "$ref": "#/components/parameters/TurnId" }], "responses": { "200": { "description": "Turn resource" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/v1/turns/{turnId}/events": { "get": { "parameters": [{ "$ref": "#/components/parameters/TurnId" }, { "$ref": "#/components/parameters/AfterSeq" }], "description": "Reconnectable SSE stream. Last-Event-ID is accepted as an alternative to after_seq. Stable journal replay precedes live projection events.", "responses": { "200": { "description": "text/event-stream" } } } },
    "/api/v1/turns/{turnId}/stop": { "post": { "parameters": [{ "$ref": "#/components/parameters/TurnId" }], "responses": { "202": { "description": "Stop requested" }, "409": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "SylphSessionCookie": { "type": "apiKey", "in": "cookie", "name": "sylph_session" } },
    "parameters": {
      "SessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
      "TurnId": { "name": "turnId", "in": "path", "required": true, "schema": { "type": "string" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
      "Before": { "name": "before", "in": "query", "schema": { "type": "integer" } },
      "Query": { "name": "q", "in": "query", "description": "Free-text query; whitespace-only is treated as absent.", "schema": { "type": "string" } },
      "AfterSeq": { "name": "after_seq", "in": "query", "schema": { "type": "integer", "default": -1 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string", "maxLength": 200 } }
    },
    "requestBodies": {
      "CreateSession": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSession" } } } },
      "ImportSession": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["traceSessionId"], "properties": { "traceSessionId": { "type": "string" } } } } } },
      "CreateTurn": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTurn" } } } }
    },
    "responses": {
      "Error": { "description": "Stable API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "SessionCreated": { "description": "Session resource" },
      "TurnAccepted": { "description": "Durable turn resource" }
    },
    "schemas": {
      "CreateSession": { "type": "object", "required": ["agent", "workdir"], "properties": { "agent": { "type": "string" }, "workdir": { "type": "string" }, "title": { "type": "string" }, "flags": { "type": "object", "additionalProperties": { "type": "string" } } } },
      "CreateTurn": { "type": "object", "properties": { "text": { "type": "string" }, "idempotencyKey": { "type": "string" }, "attachments": { "type": "array", "maxItems": 5 } } },
      "ErrorResponse": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "enum": ["INVALID_REQUEST", "SESSION_NOT_FOUND", "SESSION_ALREADY_RUNNING", "RUNNER_NOT_FOUND", "RUNNER_BROKEN", "RUNNER_START_FAILED", "RUNNER_PROTOCOL_ERROR", "TURN_FAILED", "TURN_INTERRUPTED", "STOP_ALREADY_COMPLETED", "TRACEDB_UNAVAILABLE", "TRACE_NOT_RESUMABLE", "ATTACHMENT_INVALID", "COMMAND_NOT_SUPPORTED", "APPROVAL_NOT_AVAILABLE", "POLICY_VIOLATION", "INTERNAL_ERROR"] }, "message": { "type": "string" }, "details": { "type": "object" } } } } },
      "SearchHit": { "type": "object", "description": "One lineage-collapsed archived session. TraceDB scoring internals (score, scoreBreakdown, bm25) are deliberately not exposed: they carry no UI meaning and would couple this API to TraceDB's ranking implementation.", "required": ["id", "agent"], "properties": { "id": { "type": "string", "description": "TraceDB session id, e.g. claude:uuid/agent-suffix" }, "agent": { "type": "string" }, "title": { "type": ["string", "null"] }, "ask": { "type": ["string", "null"], "description": "Opening user request" }, "cwd": { "type": ["string", "null"] }, "outcome": { "type": ["string", "null"] }, "bestMatch": { "type": ["object", "null"], "properties": { "kind": { "type": "string" }, "snippet": { "type": "string" } } }, "hits": { "type": ["integer", "null"] }, "startedAtMs": { "type": ["integer", "null"] }, "endedAtMs": { "type": ["integer", "null"] }, "lineageRootId": { "type": ["string", "null"] }, "sessionId": { "type": ["string", "null"], "description": "Live session id when this archived session was already imported, so the UI can offer open instead of a duplicate import." } } },
      "SearchResponse": { "type": "object", "required": ["results", "available"], "properties": { "results": { "type": "array", "items": { "$ref": "#/components/schemas/SearchHit" } }, "available": { "type": "boolean", "description": "False when TraceDB could not be reached at all." }, "detail": { "type": ["string", "null"], "description": "Why the archive is unavailable. Absent when available." } } },
      "Event": { "type": "object", "required": ["seq", "kind", "stability", "source"], "properties": { "seq": { "type": "integer" }, "kind": { "type": "string", "enum": ["status", "system", "user", "thinking", "assistant", "tool_call", "tool_result", "usage", "error", "approval"] }, "phase": { "type": ["string", "null"] }, "text": { "type": "string" }, "data": { "type": "object" }, "stability": { "type": "string", "enum": ["ephemeral", "stable"] }, "source": { "type": "string", "enum": ["runner", "server", "tracedb"] } } }
    }
  }
}
