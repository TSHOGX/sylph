{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sylph.dev/schema/sylph.env.v1.json",
  "title": "Sylph environment protocol v1",
  "description": "Length-delimited JSON messages exchanged by a server and an outbound envagent. Unknown message types are forward-compatible; known payloads are validated before ingest.",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/welcome"},
    {"$ref": "#/$defs/command"},
    {"$ref": "#/$defs/commandResult"},
    {"$ref": "#/$defs/eventBatch"},
    {"$ref": "#/$defs/ack"},
    {"$ref": "#/$defs/nack"},
    {"$ref": "#/$defs/heartbeat"},
    {"$ref": "#/$defs/agents"},
    {"$ref": "#/$defs/capabilitySnapshot"},
    {"$ref": "#/$defs/sourceState"},
    {"$ref": "#/$defs/turnInput"},
    {"$ref": "#/$defs/edge"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/nativeRecord"},
    {"$ref": "#/$defs/nativeBlobChunk"},
    {"$ref": "#/$defs/diagnostic"}
  ],
  "$defs": {
    "version": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": {"type": "integer", "minimum": 0},
        "minor": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "sessionId": {
      "type": "object",
      "required": ["environment", "agent", "nativeId"],
      "properties": {
        "environment": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "nativeId": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "wireTurnInput": {
      "type": "object",
      "required": ["text", "attachments", "args", "config"],
      "properties": {
        "text": {"type": "string"},
        "attachments": {"type": "array", "items": {"$ref": "#/$defs/wireAttachment"}},
        "command": {"type": ["string", "null"]},
        "args": {"type": "object", "additionalProperties": {"type": "string"}},
        "config": {"type": "object"}
      },
      "additionalProperties": false
    },
    "wireAttachment": {
      "type": "object",
      "required": ["name", "type", "data"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "data": {"type": "string", "description": "base64, no data: prefix"}
      },
      "additionalProperties": false
    },
    "fileOperation": {
      "oneOf": [
        {"type": "object", "required": ["kind", "relative"], "properties": {"kind": {"const": "list"}, "relative": {"type": "string"}}},
        {"type": "object", "required": ["kind", "relative"], "properties": {"kind": {"const": "read"}, "relative": {"type": "string"}, "limit": {"type": ["integer", "null"], "minimum": 0}}},
        {"type": "object", "required": ["kind", "relative", "data"], "properties": {"kind": {"const": "write"}, "relative": {"type": "string"}, "data": {"type": "string", "description": "base64, no data: prefix"}, "overwrite": {"type": "boolean"}}},
        {"type": "object", "required": ["kind", "relative"], "properties": {"kind": {"const": "stat"}, "relative": {"type": "string"}}},
        {"type": "object", "required": ["kind", "relative"], "properties": {"kind": {"const": "mkdir"}, "relative": {"type": "string"}}},
        {"type": "object", "required": ["kind", "relative"], "properties": {"kind": {"const": "remove"}, "relative": {"type": "string"}, "recursive": {"type": "boolean"}}}
      ]
    },
    "commandPrepare": {
      "type": "object", "required": ["kind", "draftId", "agent", "workdir"],
      "properties": {"kind": {"const": "prepare"}, "draftId": {"type": "string", "minLength": 1}, "agent": {"type": "string", "minLength": 1}, "workdir": {"type": "string"}, "flags": {"type": "object", "additionalProperties": {"type": "string"}}, "injectIdentity": {"type": "boolean"}, "identityPreamble": {"type": ["string", "null"]}, "permissionMode": {"type": ["string", "null"]}}
    },
    "commandRun": {
      "type": "object", "required": ["kind", "agent", "workdir"],
      "properties": {"kind": {"const": "run"}, "sessionId": {"anyOf": [{"$ref": "#/$defs/sessionId"}, {"type": "null"}]}, "draftId": {"type": ["string", "null"]}, "agent": {"type": "string", "minLength": 1}, "workdir": {"type": "string"}, "flags": {"type": "object", "additionalProperties": {"type": "string"}}, "injectIdentity": {"type": "boolean"}, "identityPreamble": {"type": ["string", "null"]}, "permissionMode": {"type": ["string", "null"]}, "initialInput": {"anyOf": [{"$ref": "#/$defs/wireTurnInput"}, {"type": "null"}]}, "initialTurnId": {"type": ["string", "null"]}}
    },
    "commandSend": {"type": "object", "required": ["kind", "sessionId", "turnId", "input"], "properties": {"kind": {"const": "send"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "turnId": {"type": "string", "minLength": 1}, "input": {"$ref": "#/$defs/wireTurnInput"}}},
    "commandInterrupt": {"type": "object", "required": ["kind", "sessionId"], "properties": {"kind": {"const": "interrupt"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "expectedTurnId": {"type": ["string", "null"]}}},
    "turnLease": {"type":"object","required":["turnId"],"properties":{"turnId":{"type":"string","minLength":1}}},
    "controlReceipt": {"oneOf":[{"type":"object","required":["delivery","lease"],"properties":{"delivery":{"const":"active_turn"},"lease":{"$ref":"#/$defs/turnLease"}}},{"type":"object","required":["delivery"],"properties":{"delivery":{"const":"native_queue"}}}]},
    "commandSteer": {"type": "object", "required": ["kind", "sessionId", "text"], "properties": {"kind": {"const": "steer"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "text": {"type": "string"}, "expectedTurnId": {"type": ["string", "null"]}}},
    "commandQueueSteering": {"type": "object", "required": ["kind", "sessionId", "text"], "properties": {"kind": {"const": "queue_steering"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "text": {"type": "string"}}},
    "commandQueue": {"type": "object", "required": ["kind", "sessionId", "text"], "properties": {"kind": {"const": "queue"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "text": {"type": "string"}}},
    "commandSetConfig": {"type": "object", "required": ["kind", "sessionId", "id", "value"], "properties": {"kind": {"const": "set_config"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "id": {"type": "string", "minLength": 1}, "value": {}}},
    "commandResolve": {"type": "object", "required": ["kind", "sessionId", "resolution"], "properties": {"kind": {"const": "resolve"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "resolution": {}}},
    "commandWatch": {"type": "object", "required": ["kind", "sessionId", "agent", "nativeId"], "properties": {"kind": {"const": "watch"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "agent": {"type": "string"}, "nativeId": {"type": "string"}, "turnId": {"type": ["string", "null"]}}},
    "commandAdopt": {"type": "object", "required": ["kind", "sessionId", "agent", "nativeId"], "properties": {"kind": {"const": "adopt"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "agent": {"type": "string"}, "nativeId": {"type": "string"}, "turnId": {"type": ["string", "null"]}}},
    "commandFiles": {"type": "object", "required": ["kind", "sessionId", "workdir", "operation"], "properties": {"kind": {"const": "files"}, "sessionId": {"$ref": "#/$defs/sessionId"}, "workdir": {"type": "string"}, "operation": {"$ref": "#/$defs/fileOperation"}}},
    "commandDraftCapabilities": {"type": "object", "required": ["kind", "draftId"], "properties": {"kind": {"const": "draft_capabilities"}, "draftId": {"type": "string"}}},
    "commandDraftSetConfig": {"type": "object", "required": ["kind", "draftId", "id", "value"], "properties": {"kind": {"const": "draft_set_config"}, "draftId": {"type": "string"}, "id": {"type": "string"}, "value": {}}},
    "commandDraftFiles": {"type": "object", "required": ["kind", "draftId", "operation"], "properties": {"kind": {"const": "draft_files"}, "draftId": {"type": "string"}, "operation": {"$ref": "#/$defs/fileOperation"}}},
    "commandDraftClose": {"type": "object", "required": ["kind", "draftId"], "properties": {"kind": {"const": "draft_close"}, "draftId": {"type": "string"}}},
    "commandHealth": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "health"}}},
    "commandCapabilities": {"type": "object", "required": ["kind", "sessionId"], "properties": {"kind": {"const": "capabilities"}, "sessionId": {"$ref": "#/$defs/sessionId"}}},
    "commandEnumerate": {"type": "object", "required": ["kind", "agent"], "properties": {"kind": {"const": "enumerate"}, "agent": {"type": "string"}, "workdir": {"type": ["string", "null"]}}},
    "commandActivate": {"type": "object", "required": ["kind", "sessionId"], "properties": {"kind": {"const": "activate"}, "sessionId": {"$ref": "#/$defs/sessionId"}}},
    "commandClose": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "close"}, "sessionId": {"anyOf": [{"$ref": "#/$defs/sessionId"}, {"type": "null"}]}}},
    "commandBrowseRoots": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "browse_roots"}}},
    "commandBrowseTree": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "browse_tree"}, "path": {"type": ["string", "null"]}}},
    "hello": {
      "type": "object",
      "required": ["type", "protocol", "versions", "installationId", "producerId", "connectionEpoch"],
      "properties": {
        "type": {"const": "hello"},
        "protocol": {"const": "sylph.env.v1"},
        "versions": {"type": "array", "items": {"$ref": "#/$defs/version"}},
        "environmentId": {"type": ["string", "null"]},
        "installationId": {"type": "string", "minLength": 1},
        "producerId": {"type": "string", "minLength": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0},
        "spoolCursors": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "agents": {"type": "array"},
        "health": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "welcome": {
      "type": "object",
      "required": ["type", "protocol", "version", "environmentId", "connectionEpoch", "serverEpoch", "maxBatchEvents", "heartbeatIntervalMs"],
      "properties": {
        "type": {"const": "welcome"},
        "protocol": {"const": "sylph.env.v1"},
        "version": {"$ref": "#/$defs/version"},
        "environmentId": {"type": "string", "minLength": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0},
        "serverEpoch": {"type": "integer", "minimum": 0},
        "acceptedCursors": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "maxBatchEvents": {"type": "integer", "minimum": 1},
        "heartbeatIntervalMs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "command": {
      "type": "object",
      "required": ["type", "requestId", "idempotency", "command"],
      "properties": {
        "type": {"const": "command"},
        "requestId": {"type": "string", "minLength": 1},
        "idempotency": {"enum": ["replayable", "at_most_once"]},
        "command": {"oneOf": [
          {"$ref": "#/$defs/commandPrepare"},
          {"$ref": "#/$defs/commandRun"},
          {"$ref": "#/$defs/commandSend"},
          {"$ref": "#/$defs/commandInterrupt"},
          {"$ref": "#/$defs/commandSteer"},
          {"$ref": "#/$defs/commandQueue"},
          {"$ref": "#/$defs/commandQueueSteering"},
          {"$ref": "#/$defs/commandSetConfig"},
          {"$ref": "#/$defs/commandResolve"},
          {"$ref": "#/$defs/commandWatch"},
          {"$ref": "#/$defs/commandAdopt"},
          {"$ref": "#/$defs/commandFiles"},
          {"$ref": "#/$defs/commandDraftCapabilities"},
          {"$ref": "#/$defs/commandDraftSetConfig"},
          {"$ref": "#/$defs/commandDraftFiles"},
          {"$ref": "#/$defs/commandDraftClose"},
          {"$ref": "#/$defs/commandHealth"},
          {"$ref": "#/$defs/commandCapabilities"},
          {"$ref": "#/$defs/commandEnumerate"},
          {"$ref": "#/$defs/commandActivate"},
          {"$ref": "#/$defs/commandClose"},
          {"$ref": "#/$defs/commandBrowseRoots"},
          {"$ref": "#/$defs/commandBrowseTree"}
        ]}
      },
      "additionalProperties": true
    },
    "commandResult": {
      "type": "object",
      "required": ["type", "requestId", "outcome", "connectionEpoch"],
      "properties": {
        "type": {"const": "command_result"},
        "requestId": {"type": "string", "minLength": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0},
        "outcome": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["accepted", "rejected", "unknown"]}, "code": {"type": "string", "description": "On a rejection: one of the RejectCode spellings in crates/protocol/src/env.rs, e.g. AGENT_UNAVAILABLE, WORKDIR_OUTSIDE_ROOTS, SESSION_NOT_HOSTED, POLICY_VIOLATION, FILE_NOT_FOUND. The server maps each to one HTTP error and never classifies by message text."}, "message": {"type": "string"}}}
      },
      "additionalProperties": true
    },
    "eventBatch": {
      "type": "object",
      "required": ["type", "environmentId", "producerId", "connectionEpoch", "events"],
      "properties": {
        "type": {"const": "event_batch"},
        "environmentId": {"type": "string", "minLength": 1},
        "producerId": {"type": "string", "minLength": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0},
        "events": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "required": ["producerId", "producerSeq", "sessionId", "event"], "properties": {"producerId": {"type": "string", "minLength": 1}, "producerSeq": {"type": "integer", "minimum": 1}, "sessionId": {"type": "object"}, "arrivalTurnId": {"type": ["string", "null"]}, "serverSeq": {"type": ["integer", "null"], "minimum": 0}, "sourceCursor": {"type": ["object", "null"], "required": ["source", "generation", "offset"]}, "event": {"type": "object"}}}}
      },
      "additionalProperties": true
    },
    "ack": {
      "type": "object",
      "required": ["type", "producerId", "acceptedThrough"],
      "properties": {
        "type": {"const": "ack"},
        "producerId": {"type": "string", "minLength": 1},
        "acceptedThrough": {"type": "integer", "minimum": 0},
        "serverSeqThrough": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "nack": {
      "type": "object",
      "required": ["type", "producerId", "expectedNext", "reason"],
      "properties": {
        "type": {"const": "nack"},
        "producerId": {"type": "string", "minLength": 1},
        "expectedNext": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "heartbeat": {
      "type": "object",
      "required": ["type", "connectionEpoch", "sentAtMs"],
      "properties": {
        "type": {"const": "heartbeat"},
        "connectionEpoch": {"type": "integer", "minimum": 0},
        "sentAtMs": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "agents": {
      "type": "object",
      "required": ["type", "connectionEpoch", "agents"],
      "description": "The envagent's agent inventory changed while connected. Not sequenced through the spool: it is current state about the machine, and a reconnect re-reports it in hello.",
      "properties": {
        "type": {"const": "agents"},
        "connectionEpoch": {"type": "integer", "minimum": 0},
        "agents": {"type": "array"}
      },
      "additionalProperties": true
    },
    "capabilitySnapshot": {
      "type": "object",
      "required": ["type", "sessionId", "facets", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "capability_snapshot"},
        "sessionId": {"type": "object"},
        "facets": {"type": "object"},
        "link": {"type": ["object", "null"]},
        "capabilities": {"type": ["object", "null"]},
        "producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "sourceState": {
      "type": "object",
      "required": ["type", "sessionId", "cursor", "state", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "source_state"},
        "sessionId": {"type": "object"},
        "cursor": {"type": "object", "required": ["source", "generation", "offset"]},
        "state": {"type": "string"},
        "detail": {"type": ["string", "null"]}
        ,"producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "turnInput": {
      "type": "object",
      "required": ["type", "sessionId", "turn", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "turn_input"},
        "sessionId": {"type": "object"},
        "turnId": {"type": ["string", "null"]},
        "turn": {"type": "object", "required": ["text"]},
        "producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["type", "edge", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "edge"},
        "edge": {"type": "object", "required": ["parent", "child", "relation"]},
        "producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "required": ["type", "sessionId", "request", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "request"},
        "sessionId": {"type": "object"},
        "request": {"type": "object"},
        "producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "nativeRecord": {
      "type": "object",
      "required": ["type", "sessionId", "record", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "native_record"},
        "sessionId": {"type": "object"},
        "record": {"type": "object"},
        "producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "nativeBlobChunk": {
      "type": "object",
      "required": ["type", "sessionId", "chunk", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "native_blob_chunk"},
        "sessionId": {"type": "object"},
        "chunk": {
          "type": "object",
          "required": ["source", "version", "name", "size", "offset", "data", "finalChunk"],
          "properties": {
            "source": {"type": "string"},
            "version": {"type": "integer", "minimum": 0},
            "name": {"type": "string"},
            "size": {"type": "integer", "minimum": 0},
            "offset": {"type": "integer", "minimum": 0},
            "data": {"type": "string"},
            "finalChunk": {"type": "boolean"}
          }
        },
        "producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": ["type", "level", "code", "message", "producerId", "producerSeq", "connectionEpoch"],
      "properties": {
        "type": {"const": "diagnostic"},
        "level": {"enum": ["debug", "info", "warn", "error"]},
        "code": {"type": "string"},
        "message": {"type": "string"},
        "producerId": {"type": "string", "minLength": 1},
        "producerSeq": {"type": "integer", "minimum": 1},
        "connectionEpoch": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
