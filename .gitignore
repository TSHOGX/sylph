# Rust
#
# Cargo uses the workspace root for every member, regardless of the current directory.
/target/

# Next.js / Node.js (coming in Phase 2)
/frontend/.next/
/frontend/out/
/frontend/node_modules/
/frontend/.turbo/
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite databases
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# Runtime data directories
data/
.sylph-web/
attachments/

# Test coverage
coverage/

# Playwright output. `test-results/` is matched unanchored because Playwright
# writes it relative to the process cwd, which is the backend directory when the
# E2E harness shells out to cargo.
test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.e2e-home/
# The fixture envagent's own root, which holds a pairing credential and a spool.
/frontend/.e2e-env-home/
/frontend/.e2e-data/
/frontend/test-results/

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# Local agent worktrees and session metadata
.claude/

# Machine-local development notes and credentials
/private/
